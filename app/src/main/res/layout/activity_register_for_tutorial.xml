<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="20dp"/>

        <!-- Tutorial Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/summaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Tutorial Name -->
                <TextView
                    android:id="@+id/registerTutorialName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tutorial Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <!-- Subject (optional) -->
                <TextView
                    android:id="@+id/registerTutorialSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subject"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="20dp"
                    android:visibility="gone"/>

                <!-- Date & Time Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Date"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/registerTutorialDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sep 15, 2025"
                            android:textSize="16sp"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Time"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/registerTutorialTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12:00 – 03:00"
                            android:textSize="16sp"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Location & Fee Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Location"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/registerTutorialLocation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1355 Oxford St"
                            android:textSize="16sp"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fee"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/registerTutorialFee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#A0522D"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Tutor Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tutor"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/registerTutorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tutor Name"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Availability Row -->
                <LinearLayout
                    android:id="@+id/registerAvailabilityRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Capacity"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/registerTutorialCapacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="16sp"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Spots left"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"/>

                        <TextView
                            android:id="@+id/registerTutorialSpotsLeft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="16sp"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Description Section -->
                <LinearLayout
                    android:id="@+id/registerDescriptionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/registerTutorialDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tutorial description goes here..."
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- Fallback summary (hidden) -->
                <TextView
                    android:id="@+id/tutorial_summary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:lineSpacingExtra="4dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PayPal Disclaimer (hidden for free tutorials) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/paypal_disclaimer_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info"
                    app:tint="#6B7280"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Info" />

                <TextView
                    android:id="@+id/paypal_disclaimer_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registrations are non‑refundable. You may unregister before the session; unregistering will not issue a refund."
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pay_with_paypal_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pay with PayPal"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp"
                android:backgroundTint="#111827"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textAllCaps="false"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="14dp"
                app:strokeColor="#E5E7EB"
                android:textColor="#111827"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
