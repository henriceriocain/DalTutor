<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Tutorial Header Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tutorial Details"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light"
            android:textStyle="normal"
            android:textColor="#333333"
            android:layout_marginBottom="32dp"/>

        <!-- Tutorial Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Tutorial Name -->
                <TextView
                    android:id="@+id/tutorialName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tutorial Name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <!-- Subject -->
                <TextView
                    android:id="@+id/tutorialSubject"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subject"
                    android:textSize="16sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone"/>

                <!-- Details Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Date & Time Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Date"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"/>

                            <TextView
                                android:id="@+id/tutorialDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sep 15, 2024"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:fontFamily="sans-serif"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Time"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"/>

                            <TextView
                                android:id="@+id/tutorialTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2:00 PM - 4:00 PM"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:fontFamily="sans-serif"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Location & Fee Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Location"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"/>

                            <TextView
                                android:id="@+id/tutorialLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Study Hall A"
                                android:textSize="16sp"
                                android:textColor="#333333"
                                android:fontFamily="sans-serif"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fee"
                                android:textSize="12sp"
                                android:textColor="#888888"
                                android:fontFamily="sans-serif-medium"
                                android:textAllCaps="true"
                                android:letterSpacing="0.1"/>

                            <TextView
                                android:id="@+id/tutorialFee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$25"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#A0522D"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description Section -->
                    <LinearLayout
                        android:id="@+id/descriptionSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Description"
                            android:textSize="12sp"
                            android:textColor="#888888"
                            android:fontFamily="sans-serif-medium"
                            android:textAllCaps="true"
                            android:letterSpacing="0.1"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tutorialDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tutorial description goes here..."
                            android:textSize="16sp"
                            android:textColor="#333333"
                            android:fontFamily="sans-serif"
                            android:lineSpacingExtra="4dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tutor Information Card -->
        <include layout="@layout/tutor_info_card" />

        <!-- Registered Students (Tutor Only) -->
        <LinearLayout
            android:id="@+id/registered_students_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/registeredStudentsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registered Students"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"/>
            </LinearLayout>

            <!-- No Students Text -->
            <TextView
                android:id="@+id/noRegisteredStudentsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No students registered yet"
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone"/>

            <!-- Students List -->
            <LinearLayout
                android:id="@+id/registeredStudentsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <!-- Action Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <!-- Register Button -->
            <Button
                android:id="@+id/register_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Register for Tutorial"
                android:backgroundTint="#A0522D"
                android:textColor="#FFFFFF"
                android:padding="16dp"
                android:textSize="16sp"
                android:layout_marginBottom="16dp"
                app:cornerRadius="12dp"
                android:elevation="0dp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"/>

            <!-- Back Button -->
            <Button
                android:id="@+id/back_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Map"
                android:textColor="#A0522D"
                android:padding="16dp"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:strokeColor="#A0522D"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
