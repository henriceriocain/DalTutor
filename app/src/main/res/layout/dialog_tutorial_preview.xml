<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp"
    app:cardUseCompatPadding="false"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tutorial Preview"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#111827" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="12dp" />

        <!-- Meta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tutorial -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tutorial"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tutorial_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Tutor -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tutor"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tutor_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Topic -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Topic"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/topic_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Fee -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Fee"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/fee_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Capacity (optional) -->
            <TextView
                android:id="@+id/capacity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Capacity"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone" />

            <TextView
                android:id="@+id/capacity_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/date_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Time -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/time_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />

            <View android:layout_width="match_parent" android:layout_height="12dp" />

            <!-- Location -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:letterSpacing="0.02"
                android:textColor="#111827"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/location_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#111827"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="16dp" />

        <!-- Description -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:letterSpacing="0.02"
            android:textColor="#111827"
            android:fontFamily="sans-serif-medium" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp"
            android:fadeScrollbars="false"
            android:overScrollMode="ifContentScrolls">

            <TextView
                android:id="@+id/description_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:fontFamily="sans-serif"
                android:autoLink="web" />
        </ScrollView>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Disclaimer -->
        <TextView
            android:id="@+id/disclaimer_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Note: Once published, tutorials are not editable. If learners have already registered, the session cannot be canceled."
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="8dp" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/edit_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="#6B7280"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/confirm_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publish"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:padding="8dp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
