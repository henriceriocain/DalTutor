<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Header Section -->
        <TextView
            android:id="@+id/historyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registration History"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="24dp"/>

        <!-- Upcoming Tutorials Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Section Header -->
                <TextView
                    android:id="@+id/upcomingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming (0)"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#374151"
                    android:layout_marginBottom="16dp" />

                <!-- Upcoming Tutorials List -->
                <LinearLayout
                    android:id="@+id/upcomingTutorialsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Empty State for Upcoming -->
                <LinearLayout
                    android:id="@+id/upcomingEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="16dp"
                        android:src="@android:drawable/ic_menu_today"
                        app:tint="#D1D5DB" />

                    <TextView
                        android:id="@+id/upcomingEmptyMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No upcoming registrations"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Past Tutorials Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Section Header -->
                <TextView
                    android:id="@+id/pastCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Past (0)"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#374151"
                    android:layout_marginBottom="16dp" />

                <!-- Past Tutorials List -->
                <LinearLayout
                    android:id="@+id/pastTutorialsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Empty State for Past -->
                <LinearLayout
                    android:id="@+id/pastEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginBottom="16dp"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#D1D5DB" />

                    <TextView
                        android:id="@+id/pastEmptyMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No past registrations yet"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:gravity="center" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>