<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Tutorial Name -->
        <TextView
            android:id="@+id/tutorialName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tutorial Name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp"/>

        <!-- Subject -->
        <TextView
            android:id="@+id/tutorialSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subject"
            android:textSize="14sp"
            android:textColor="#6B7280"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="20dp"
            android:visibility="gone"/>

        <!-- Details Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Date & Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tutorialDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sep 15, 2024"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Time"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tutorialTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12:00 - 03:00"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Location & Fee Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Location"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tutorialLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Study Hall A"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fee"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tutorialFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$25"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#A0522D"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Availability Row -->
            <LinearLayout
                android:id="@+id/availabilityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Capacity"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tutorialCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spots left"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:id="@+id/tutorialSpotsLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Description Section -->
            <LinearLayout
                android:id="@+id/descriptionSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tutorialDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tutorial description goes here..."
                    android:textSize="16sp"
                    android:textColor="#111827"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
