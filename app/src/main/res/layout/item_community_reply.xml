<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Reply Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/text_reply_author_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Sarah Wilson" />

                <TextView
                    android:id="@+id/text_reply_author_role"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/role_chip_background"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#666666"
                    android:textAllCaps="true"
                    android:layout_marginStart="6dp"
                    tools:text="TUTOR" />

            </LinearLayout>

            <TextView
                android:id="@+id/text_reply_timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="#6B7280"
                tools:text="1h ago" />

        </LinearLayout>

        <!-- In-reply-to indicator (shown for nested replies) -->
        <TextView
            android:id="@+id/text_in_reply_to"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            tools:text="↪︎ In reply to Sarah" />

        <!-- Reply Content -->
        <TextView
            android:id="@+id/text_reply_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#111827"
            android:lineSpacingExtra="3dp"
            android:layout_marginBottom="12dp"
            tools:text="You should start by identifying the entities in your system first, then determine the relationships between them. For many-to-many relationships, you'll need a junction table." />

        <!-- Reply Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Star group: single icon + count; whole row clickable -->
            <LinearLayout
                android:id="@+id/reply_star_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp">

                <ImageButton
                    android:id="@+id/btn_reply_star"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_star"
                    android:contentDescription="Star reply" />

                <TextView
                    android:id="@+id/text_reply_star_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="#6B7280"
                    android:layout_marginStart="4dp"
                    tools:text="3" />

            </LinearLayout>

            <!-- Reply action -->
            <TextView
                android:id="@+id/btn_reply_to"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reply"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btn_reply_delete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="#6B7280"
                android:contentDescription="Delete reply"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
