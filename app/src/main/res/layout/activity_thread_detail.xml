<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="thread"
            type="com.example.csci3130group1.models.CommunityThread" />
        <variable
            name="viewModel"
            type="com.example.csci3130group1.ui.community.CommunityViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:fitsSystemWindows="true">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="96dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Page Title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thread"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:layout_marginBottom="16dp"/>

                <!-- Thread Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:strokeColor="#E5E7EB"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Header: Author + time + delete -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@android:drawable/ic_menu_myplaces"
                                    app:tint="#6B7280" />

                                <TextView
                                    android:id="@+id/textThreadAuthorName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#111827"
                                    android:fontFamily="sans-serif-medium"
                                    android:layout_marginStart="6dp"
                                    tools:text="John Doe" />

                                <TextView
                                    android:id="@+id/textThreadAuthorRole"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/role_chip_background"
                                    android:paddingHorizontal="8dp"
                                    android:paddingVertical="3dp"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#666666"
                                    android:textAllCaps="true"
                                    android:layout_marginStart="8dp"
                                    tools:text="TUTOR" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/textThreadTimestamp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="12sp"
                                android:textColor="#6B7280"
                                tools:text="2h ago" />

                            <ImageButton
                                android:id="@+id/btnDeleteThread"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="8dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_menu_delete"
                                android:tint="#6B7280"
                                android:contentDescription="Delete thread"
                                android:visibility="gone" />
                        </LinearLayout>

                        <!-- Category -->
                        <TextView
                            android:id="@+id/textThreadCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#6B7280"
                            android:layout_marginBottom="8dp"
                            tools:text="Computer Science" />

                        <!-- Title -->
                        <TextView
                            android:id="@+id/textThreadTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="8dp"
                            android:maxLines="3"
                            android:ellipsize="end"
                            tools:text="Need help with CSCI 3130 Assignment 2" />

                        <!-- Description -->
                        <TextView
                            android:id="@+id/textThreadDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginBottom="12dp"
                            tools:text="I'm struggling with the database design part of the assignment. Looking for someone who can help me understand the ER diagrams better." />

                        <!-- Actions: Star + Replies count -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginEnd="12dp">

                                <ImageButton
                                    android:id="@+id/btnThreadStar"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="@android:color/transparent"
                                    android:src="@drawable/ic_star"
                                    android:contentDescription="Star thread" />

                                <TextView
                                    android:id="@+id/textThreadStarCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textSize="14sp"
                                    android:textColor="#6B7280"
                                    android:layout_marginStart="4dp"
                                    tools:text="5 stars" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/textThreadReplyCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="14sp"
                                android:textColor="#6B7280"
                                tools:text="12 replies" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Replies Section Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Replies"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <!-- Replies RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerReplies"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="12dp"
                    tools:listitem="@layout/item_community_reply" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/emptyRepliesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginBottom="16dp"
                        android:src="@drawable/ic_reply"
                        app:tint="#CCCCCC" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No replies yet"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#666666"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Be the first to reply!"
                        android:textSize="14sp"
                        android:textColor="#888888" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Composer at bottom -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:hint="Write a reply..."
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editReplyText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="4"
                        android:inputType="textCapSentences|textMultiLine" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnSendReply"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/brown_primary"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
