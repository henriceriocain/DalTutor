<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Content Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="12dp">

            <!-- Tutorial Title -->
            <TextView
                android:id="@+id/tutorialTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tutorial Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="6dp" />

            <!-- Tutor Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_info"
                    app:tint="#666666"
                    android:contentDescription="Tutor Icon"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tutorInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tutor Name"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

            <!-- Time and Fee Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_info"
                    app:tint="#A0522D"
                    android:contentDescription="Details Icon"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tutorialDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time and Fee Details"
                    android:textSize="14sp"
                    android:textColor="#A0522D"
                    android:fontFamily="sans-serif-medium" />

            </LinearLayout>

        </LinearLayout>

        <!-- Arrow Icon -->
        <ImageView
            android:id="@+id/arrowIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_map"
            app:tint="#A0522D"
            android:contentDescription="View Details"
            android:rotation="90" />

    </LinearLayout>

</androidx.cardview.widget.CardView>