<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Optional Icon Decoration (placed on top layer) -->
    <ImageView
        android:id="@+id/profile_icon"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_myplaces"
        android:alpha="0.8"
        android:scaleType="centerInside"
        android:elevation="8dp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Profile Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/profile_card"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_centerHorizontal="true"
            app:cardCornerRadius="35dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="#EFEBE9">

            <LinearLayout
                android:id="@+id/profile_info_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                >

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="User Name"
                    android:textSize="22sp"
                    android:textColor="#813B09"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/profileRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Role: Student/Tutor"
                    android:textSize="16sp"
                    android:textColor="#813B09"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/profileRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average Rating: 0.0 ★ (0 reviews)"
                    android:textSize="16sp"
                    android:textColor="#813B09"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Logout Button (placed below the profile card) -->
        <Button
            android:id="@+id/logout_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/profile_card"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:text="Log Out"
            android:padding="12dp"
            android:backgroundTint="#A0522D"
             />
    </RelativeLayout>
</FrameLayout>