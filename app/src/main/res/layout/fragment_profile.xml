<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Greeting Section -->
        <TextView
            android:id="@+id/profileGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hi, User!"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:textStyle="normal"
            android:textColor="#333333"
            android:layout_marginBottom="32dp"/>

        <!-- Profile Details Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Profile Header with Picture -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Profile Picture (larger, centered) -->
                    <ImageView
                        android:id="@+id/profilePicture"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#A0522D"
                        android:background="@drawable/circle_background"
                        android:padding="20dp"
                        android:contentDescription="Profile Picture" />

                    <!-- Name centered -->
                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="12dp" />

                    <!-- Email centered, subtle -->
                    <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@example.com"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:layout_marginTop="4dp" />

                    <!-- Degree as a subtle chip -->
                    <TextView
                        android:id="@+id/profileDegree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/role_chip_background"
                        android:visibility="gone"/>

                    <!-- Contact Row -->
                    <LinearLayout
                        android:id="@+id/contactContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/ic_menu_call"
                            app:tint="#A0522D" />

                        <TextView
                            android:id="@+id/profileContact"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="#A0522D"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Rating (for tutors) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@android:drawable/btn_star_big_on"
                            app:tint="#FFD700" />

                        <TextView
                            android:id="@+id/profileRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="14sp"
                            android:textColor="#666666"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Description Section -->
                <LinearLayout
                    android:id="@+id/descriptionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/profileStudentDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="16sp"
                        android:textColor="#333333"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>

                <!-- Edit Profile link -->
                <TextView
                    android:id="@+id/edit_profile_link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit profile"
                    android:textColor="#A0522D"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Reviews Card (Tutor Only) -->
        <LinearLayout
            android:id="@+id/reviews_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <!-- Reviews Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/reviewsHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reviews"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"/>
            </LinearLayout>

            <!-- No Reviews Text -->
            <TextView
                android:id="@+id/profileNoReviewsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_reviews_yet"
                android:textSize="16sp"
                android:textColor="#666666"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone"/>

            <!-- Reviews List -->
            <LinearLayout
                android:id="@+id/profileReviewsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- See All Reviews link (visible only if there are reviews) -->
            <TextView
                android:id="@+id/seeAllReviewsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/see_all_reviews"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:padding="4dp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Combined Upcoming Activity Card (Tutor Tools enabled AND both sides have upcoming) -->
        <LinearLayout
            android:id="@+id/combined_upcoming_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:contentDescription="Upcoming Activity Icon" />

                <TextView
                    android:id="@+id/combinedUpcomingHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Activity"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Upcoming registrations preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Registrations"
                android:textSize="14sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif-medium" />
            <LinearLayout
                android:id="@+id/combinedUpcomingRegsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/combinedUpcomingRegsLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all registrations"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginVertical="12dp" />

            <!-- Upcoming tutorials preview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tutorials"
                android:textSize="14sp"
                android:textColor="#666666"
                android:fontFamily="sans-serif-medium" />
            <LinearLayout
                android:id="@+id/combinedUpcomingTutsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/combinedUpcomingTutsLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all tutorials"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Upcoming Tutorials Card -->
        <LinearLayout
            android:id="@+id/upcoming_tutorials_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <!-- Upcoming Tutorials Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:contentDescription="Upcoming Tutorial Icon" />

                <TextView
                    android:id="@+id/upcomingHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Registrations"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Upcoming Tutorials List -->
            <LinearLayout
                android:id="@+id/upcomingTutorialsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading upcoming tutorials..."
                    android:textSize="16sp"
                    android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Tutorial Summary Card (Student registrations summary) -->
        <LinearLayout
            android:id="@+id/student_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp">

            <!-- Registration Summary Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:contentDescription="Tutorial History Icon" />

                <TextView
                    android:id="@+id/summaryHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registration Summary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Modern stats row for registrations (shown when data available) -->
            <LinearLayout
                android:id="@+id/studentStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/studentTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/studentUpcomingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/studentCompletedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>

            <!-- Legacy stats text (shown when no data) -->
            <TextView
                android:id="@+id/tutorialStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading tutorial history..."
                android:textSize="16sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <!-- View All Tutorials Button -->
            <TextView
                android:id="@+id/view_tutorials_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all registrations"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:padding="4dp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Combined Activity Card (Tutor Tools enabled AND has registrations AND tutorials) -->
        <LinearLayout
            android:id="@+id/combined_activity_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_dashboard_black_24dp"
                    android:contentDescription="Activity Icon" />

                <TextView
                    android:id="@+id/combinedHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Activity"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Registrations stat row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrations"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/combinedRegTotalValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/combinedRegUpcomingValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/combinedRegCompletedValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Upcoming"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Completed"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />
                </LinearLayout>
                <TextView
                    android:id="@+id/combinedViewRegistrationsLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all registrations"
                    android:textColor="#A0522D"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Tutorials stat row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tutorials"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:fontFamily="sans-serif-medium" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:id="@+id/combinedTutTotalValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/combinedTutUpcomingValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                    <TextView
                        android:id="@+id/combinedTutCompletedValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Upcoming"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Completed"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:gravity="center" />
                </LinearLayout>
                <TextView
                    android:id="@+id/combinedViewTutorialsLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View all tutorials"
                    android:textColor="#A0522D"
                    android:textSize="13sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tutor Upcoming Tutorials (visible when Tutor Tools enabled) -->
        <LinearLayout
            android:id="@+id/tutor_upcoming_tutorials_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_today"
                    android:contentDescription="Upcoming Tutorial Icon" />

                <TextView
                    android:id="@+id/tutorUpcomingHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Tutorials"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tutorUpcomingTutorialsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Tutor Summary Card (visible when Tutor Tools enabled) -->
        <LinearLayout
            android:id="@+id/tutor_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="24dp"
            android:elevation="2dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:contentDescription="Tutorial History Icon" />

                <TextView
                    android:id="@+id/tutorSummaryHeaderText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tutorial Summary"
                    android:textSize="20sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#333333"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Modern stats row for tutorials (shown when data available) -->
            <LinearLayout
                android:id="@+id/tutorStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tutorTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tutorUpcomingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/tutorCompletedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#333333" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Completed"
                        android:textSize="12sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>

            <!-- Legacy stats text (shown when no data) -->
            <TextView
                android:id="@+id/tutorTutorialStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading tutorial history..."
                android:textSize="16sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/view_all_tutorials_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all tutorials"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:padding="4dp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <!-- Tutor Tools (Bottom) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/tutorToolsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tutor Tools"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <!-- Row: Enable Tutor Tools -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Enable Tutor Tools"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Publish sessions and appear in search"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchEnableTutorTools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                

                <TextView
                    android:id="@+id/btnCreateTutorial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create a tutorial"
                    android:textColor="#A0522D"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:visibility="gone"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Logout link -->
        <TextView
            android:id="@+id/logout_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log out"
            android:textColor="#A0522D"
            android:textSize="13sp"
            android:padding="4dp"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</ScrollView>
