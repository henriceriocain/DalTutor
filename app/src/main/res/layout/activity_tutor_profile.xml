<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Header Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tutor Profile"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:textColor="#111827"
            android:layout_marginBottom="20dp"/>

        <!-- Tutor Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Profile Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">

                    <!-- Profile Picture -->
                    <ImageView
                        android:id="@+id/tutorProfilePicture"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="#A0522D"
                        android:background="@drawable/circle_background"
                        android:padding="20dp"
                        android:contentDescription="Tutor Profile Picture" />

                    <!-- Profile Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="20dp">

                        <!-- Tutor Name -->
                        <TextView
                            android:id="@+id/tutorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tutor Name"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#111827"
                            android:fontFamily="sans-serif-medium" />

                        <!-- Degree -->
                        <TextView
                            android:id="@+id/tutorDegree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Computer Science, B.Sc."
                            android:textSize="14sp"
                            android:textColor="#6B7280"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginTop="4dp"
                            android:visibility="gone" />

                        <!-- Stats Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="12dp">

                            <!-- First Row: Tutorial Count and Rating -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginBottom="8dp">

                                <!-- Tutorial Count -->
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:layout_marginEnd="20dp">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@android:drawable/ic_menu_recent_history"
                                        app:tint="#6B7280" />

                                    <TextView
                                        android:id="@+id/tutorialCount"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="15 tutorials"
                                        android:textSize="14sp"
                                        android:textColor="#6B7280"
                                        android:layout_marginStart="6dp" />
                                </LinearLayout>

                                <!-- Rating -->
                                <LinearLayout
                                    android:id="@+id/ratingContainer"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical"
                                    android:visibility="gone">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:src="@android:drawable/btn_star_big_on"
                                        app:tint="#FFD700" />

                                    <TextView
                                        android:id="@+id/tutorRating"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="4.8 (24)"
                                        android:textSize="14sp"
                                        android:textColor="#6B7280"
                                        android:layout_marginStart="6dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Contact Row -->
                            <LinearLayout
                                android:id="@+id/contactContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:visibility="gone">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@android:drawable/ic_menu_call"
                                    app:tint="#A0522D" />

                                <TextView
                                    android:id="@+id/tutorContact"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="(902) 123-4567"
                                    android:textSize="14sp"
                                    android:textColor="#A0522D"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Description Section -->
                <LinearLayout
                    android:id="@+id/descriptionSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="About"
                        android:textSize="14sp"
                        android:textColor="#6B7280"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:id="@+id/tutorDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tutor description goes here..."
                        android:textSize="16sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reviews Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Reviews Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tutorReviewsHeader"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/reviews"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#111827"/>

                    <Button
                        android:id="@+id/addReviewButton"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Add Review"
                        android:textColor="#111827"
                        android:textSize="12sp"
                        android:textAllCaps="false"
                        android:fontFamily="sans-serif-medium"
                        app:strokeColor="#E5E7EB"
                        app:cornerRadius="14dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="16dp"/>
                </LinearLayout>

                <!-- No Reviews Text -->
                <TextView
                    android:id="@+id/noReviewsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No reviews"
                    android:textSize="16sp"
                    android:textColor="#6B7280"
                    android:gravity="center"
                    android:padding="20dp"
                    android:visibility="visible"/>

                <!-- Reviews List -->
                <LinearLayout
                    android:id="@+id/reviewsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Upcoming Tutorials Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/upcoming_tutorials_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

            <!-- Upcoming Tutorials Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_today"
                    app:tint="#6B7280"
                    android:contentDescription="Upcoming Tutorial Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming Tutorials"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#111827"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Upcoming Tutorials List -->
            <LinearLayout
                android:id="@+id/upcomingTutorialsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Loading upcoming tutorials..."
                    android:textSize="16sp"
                    android:textColor="#6B7280"/>
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tutorial Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

            <!-- Tutorial Summary Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    app:tint="#6B7280"
                    android:contentDescription="Tutorial History Icon" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tutorial Summary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#111827"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

            <!-- Modern stats row for tutorials (shown when data available) -->
            <LinearLayout
                android:id="@+id/tutorStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <!-- Total Tutorials -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tutorTotalValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"/>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Upcoming Tutorials -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tutorUpcomingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"/>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Upcoming"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Past Tutorials -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tutorCompletedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="20sp"
                        android:textColor="#111827"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold"/>
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Past"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Fallback Tutorial Stats (legacy text format) -->
            <TextView
                android:id="@+id/tutorialStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading tutorial history..."
                android:textSize="16sp"
                android:textColor="#6B7280"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp"
                android:visibility="visible"/>

            <!-- View All Tutorials Link -->
            <TextView
                android:id="@+id/view_all_tutorials_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View all tutorials"
                android:textColor="#A0522D"
                android:textSize="13sp"
                android:padding="4dp"
                android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
