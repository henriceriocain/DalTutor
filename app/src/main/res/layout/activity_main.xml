<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#e4e2dc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="32dp"
    android:paddingVertical="60dp"
    tools:context=".MainActivity">

    <!-- Large Logo -->
    <ImageView
        android:id="@+id/app_icon"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:src="@drawable/app_icon"
        android:scaleType="centerInside"
        android:layout_marginBottom="60dp"
        android:contentDescription="DalTutor Logo" />

    <!-- App Tagline -->
    <TextView
        android:id="@+id/app_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connecting knowledge seekers with experts"
        android:textSize="18sp"
        android:textColor="#2D333A"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="80dp" />

    <!-- Spacer to push buttons to bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Sign In Button -->
    <Button
        android:id="@+id/login_button"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign in"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#111827"
        app:rippleColor="@color/btn_black_ripple"
        app:cornerRadius="14dp"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="16dp" />

    <!-- Create Account Link -->
    <TextView
        android:id="@+id/register_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Create account"
        android:textColor="#A0522D"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:padding="12dp"
        android:layout_gravity="center_horizontal"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>