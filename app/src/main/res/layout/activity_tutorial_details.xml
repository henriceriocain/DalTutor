<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F6DBB8">

    <TextView
        android:id="@+id/tutorial_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tutorial Title"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#813B09"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tutorial_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location: Killam Library"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tutorial_fee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fee: $25"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tutorial_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date: 2025-03-15"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tutorial_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Time: 14:00"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tutorial_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Duration: 60 minutes"
                android:textSize="18sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/back_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Map"
        android:backgroundTint="#A0522D"
        android:textColor="@android:color/white" />

</LinearLayout>